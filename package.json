{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-local-settings/src/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "PI_OFFLINE=1 node --test packages/*/test/*.test.ts",
    "check:pack": "PI_OFFLINE=1 node --test packages/*/test/pack.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "24.10.1",
    "release-please": "17.3.0",
    "typescript": "5.9.3"
  }
}
